*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Bundle-specific: large input data should never be committed.
# These directories should be populated locally per the README.
data/grace/*.nc
data/gldas/*.csv
data/modis_et/*.csv
data/cgwb_wells/*.csv
data/imd_rain/*.tif
data/imd_rain/daily/
data/masks/whymap/
data/masks/glim/

# Outputs are generated by running the pipeline; not committed.
outputs/timeseries/*.csv
outputs/timeseries/*.txt
outputs/figures/*.png

# Keep directory placeholders (see .gitkeep convention)
!data/.gitkeep
!outputs/timeseries/.gitkeep
!outputs/figures/.gitkeep
